# PyPNM Production Environment Variables
# Copy to .env and customize for your deployment

# ============================================
# Security - CHANGE THESE IN PRODUCTION!
# ============================================
AGENT_AUTH_TOKEN=your-secure-agent-token-here
SECRET_KEY=your-flask-secret-key-here

# ============================================
# ISW API Configuration (Device List)
# ============================================
APPDB_API_URL=https://appdb.oss.local/isw/api
APPDB_API_USER=isw
APPDB_API_PASS=Spyem_OtGheb4

# ============================================
# TFTP Server Configuration
# ============================================
# General TFTP for CMTS (E6000/Casa/vCCAP)
TFTP_IPV4=172.16.6.101
# Alternate TFTP for Cisco CMTS and CM operations
TFTP_IPV4_ALT=172.22.147.18

# ============================================
# SNMP Communities
# ============================================
# CMTS read community
CMTS_COMMUNITY=public
CMTS_SNMP_COMMUNITY=public
# Modem read community
MODEM_COMMUNITY=private
CM_SNMP_COMMUNITY=private

# Per-vendor SNMP communities (for agent)
SNMP_COMMUNITY_ARRIS=public
SNMP_COMMUNITY_CASA=public
SNMP_COMMUNITY_CISCO=public
SNMP_COMMUNITY_COMMSCOPE=public
SNMP_WRITE_COMMUNITY_ARRIS=private
SNMP_WRITE_COMMUNITY_CASA=private
SNMP_WRITE_COMMUNITY_CISCO=private
SNMP_WRITE_COMMUNITY_COMMSCOPE=private

# ============================================
# PyPNM Server
# ============================================
PYPNM_VERSION=latest
PYPNM_PORT=8000
LOG_LEVEL=INFO

# ============================================
# Redis Cache
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=86400

# ============================================
# Docker Build Cache Busting
# ============================================
CACHEBUST=1
