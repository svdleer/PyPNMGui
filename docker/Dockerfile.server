FROM ubuntu:24.04

LABEL maintainer="PyPNM Team"
LABEL description="PyPNM Web GUI Server with WebSocket agent support"

ARG http_proxy
ARG https_proxy
ARG no_proxy
ENV http_proxy=$http_proxy \
    https_proxy=$https_proxy \
    no_proxy=$no_proxy \
    HTTP_PROXY=$http_proxy \
    HTTPS_PROXY=$https_proxy \
    NO_PROXY=$no_proxy \
    PIP_CONFIG_FILE=/etc/pip.conf

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gosu \
    tzdata \
    snmp \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Set timezone
ENV TZ=Europe/Amsterdam
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Create non-root user (align UID/GID with API container for shared /app/data volume)
RUN useradd -m -u 10001 -s /bin/bash pypnm

WORKDIR /app

# Create Python virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements first (better caching)
COPY backend/requirements.txt .

# Optional pip proxy (system-wide so it works for root and non-root users)
RUN if [ -n "${http_proxy}" ]; then \
      printf "[global]\nproxy = %s\n" "${http_proxy}" > /etc/pip.conf; \
    fi

RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Remove proxy settings from final image
ENV http_proxy= https_proxy= no_proxy= HTTP_PROXY= HTTPS_PROXY= NO_PROXY=

# Copy application
COPY backend/ .
COPY frontend/ ./frontend/
COPY docker/gui-entrypoint.sh /app/gui-entrypoint.sh

# Create directories
RUN mkdir -p /app/data /app/logs && \
    chown -R pypnm:pypnm /app && \
    chmod +x /app/gui-entrypoint.sh

USER root

ENV FLASK_APP=run.py
ENV FLASK_ENV=production
ENV PYTHONUNBUFFERED=1
ENV PYPNM_DATA_DIR=/app/data
ENV PYPNM_LOG_DIR=/app/logs

EXPOSE 5050

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5050/api/health || exit 1

ENTRYPOINT ["/app/gui-entrypoint.sh"]
CMD ["gunicorn", "--worker-class", "eventlet", "-w", "4", "--bind", "0.0.0.0:5050", "--timeout", "300", "--keep-alive", "120", "run:app"]
