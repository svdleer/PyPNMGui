# PyPNM Production Environment Template
# Copy to docker/.env.pypnm and fill real values.
# Do NOT commit secret-bearing env files.

# ============================================
# Security
# ============================================
AGENT_AUTH_TOKEN=CHANGE_ME_SECURE_AGENT_TOKEN
SECRET_KEY=CHANGE_ME_FLASK_SECRET

# ============================================
# Microsoft 365 / Entra authentication (LI-compatible MSAL flow)
# ============================================
# AUTH_PROVIDER=o365 disables local sign-in by default. Set
# EMERGENCY_LOCAL_AUTH=true only for a controlled local-login fallback.
AUTH_PROVIDER=o365
AZURE_AUTHORITY=https://login.microsoftonline.com/YOUR_TENANT_ID
AZURE_CLIENT_ID=YOUR_APP_REGISTRATION_CLIENT_ID
AZURE_CLIENT_SECRET=YOUR_APP_REGISTRATION_CLIENT_SECRET
OIDC_PROVIDER_LABEL=Microsoft 365
EMERGENCY_LOCAL_AUTH=false
# Optional RBAC mappings: comma-separated Entra role names, group IDs, or emails.
O365_ADMIN_GROUPS=
O365_VIEWER_GROUPS=
O365_ADMIN_ROLES=admin
O365_VIEWER_ROLES=viewer
O365_ADMIN_EMAILS=
O365_VIEWER_EMAILS=
# Set true only when signing out must also sign out at Microsoft.
O365_GLOBAL_LOGOUT=false

# ============================================
# ISW API Configuration
# ============================================
APPDB_API_URL=https://appdb.oss.local/isw/api
APPDB_API_USER=CHANGE_ME
APPDB_API_PASS=CHANGE_ME

# ============================================
# TFTP / FTP Configuration
# ============================================
# General TFTP for CMTS (E6000/Casa/vCCAP)
TFTP_IPV4=212.178.218.234
# Alternate TFTP for Cisco CMTS and CM operations
TFTP_IPV4_ALT=127.0.0.1

# FTP server for PNM capture retrieval/housekeeping
FTP_SERVER_IP=172.22.170.30
FTP_USER=CHANGE_ME
FTP_PASSWORD=CHANGE_ME
# Relative path on FTP root where captures are written
FTP_TFTPBOOT_DIR=pnmupload

# Scoped retrieval policy
# CM (modem-side docs measurements): local|ftp|agent
CM_TFTP=agent
# CMTS (upstream/cmts captures): local|ftp|agent
CMTS_TFTP=ftp
# Optional vendor override (set only when Cisco CMTS captures must use file-agent)
# Values: local|ftp|agent
CMTS_TFTP_CISCO=ftp
# Vendor aliases (same values: local|ftp|agent). If unset, CMTS_TFTP is used.
# These are accepted by UTSC streamer for per-vendor mode selection.
CISCO_TFTP=
COMMSCOPE_TFTP=
CASA_TFTP=
# Global fallback (used when scoped vars are absent)
PNM_FILE_SOURCE=local

# API cache dir for FTP-prefetched captures
PNM_CACHE_DIR=/app/data/pnm_cache

# ============================================
# Build-time proxy (Docker builds)
# ============================================
# IMPORTANT: must use http:// scheme for this proxy.
PYPNM_BUILD_PROXY=http://proxy.ext.oss.local:8080

# ============================================
# SNMP Communities
# ============================================
CMTS_COMMUNITY=public
CMTS_SNMP_COMMUNITY=public
MODEM_COMMUNITY=CHANGE_ME_MODEM_COMMUNITY
CM_SNMP_COMMUNITY=CHANGE_ME_MODEM_COMMUNITY

# Comma/space separated CIDRs to ignore globally (not polled/shown/persisted)
# Example: MODEM_IGNORE_CIDRS=10.254.0.0/9,10.160.0.0/16,10.128.0.0/15
MODEM_IGNORE_CIDRS=

# Per-vendor SNMP communities (agent)
SNMP_COMMUNITY_ARRIS=public
SNMP_COMMUNITY_CASA=public
SNMP_COMMUNITY_CISCO=public
SNMP_COMMUNITY_COMMSCOPE=public
SNMP_WRITE_COMMUNITY_ARRIS=private
SNMP_WRITE_COMMUNITY_CASA=private
SNMP_WRITE_COMMUNITY_CISCO=private
SNMP_WRITE_COMMUNITY_COMMSCOPE=private

# ============================================
# PyPNM Server
# ============================================
PYPNM_VERSION=latest
PYPNM_PORT=8000
# Maximum CMTS inventory size. Keep this above the largest CMTS population.
CM_MODEM_LIMIT=50000
# Override PyPNM API base URL for GUI (e.g. local SSH tunnel)
PYPNM_BASE_URL=http://127.0.0.1:8888
LOG_LEVEL=INFO
ENABLE_TOPOLOGY=false

# Topology ingestion (handled by PyPNM API)
# Host path mounted into PyPNM API as /app/data/topology (docker-compose.prod.yml)
TOPOLOGY_VOLUME_HOST=/Users/silvester/PythonDev/Git/PyPNMGui/deploy/topology-volume
TOPOLOGY_VOLUME_DIR=/app/data/topology
TOPOLOGY_DB_HOST=127.0.0.1
TOPOLOGY_DB_PORT=3306
TOPOLOGY_DB_USER=pypnm
TOPOLOGY_DB_PASSWORD=CHANGE_ME_TOPOLOGY_DB_PASSWORD
TOPOLOGY_DB_NAME=pypnm_topology

# ============================================
# Redis Cache
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=86400

# ============================================
# Docker Build Cache Busting
# ============================================
CACHEBUST=1
