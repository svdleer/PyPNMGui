# Lab Environment Configuration
# Copy to .env.lab and fill in actual values
# This file should be added to .gitignore

# Lab SSH Access
LAB_SSH_HOST=access-engineering.nl
LAB_SSH_PORT=65001
LAB_SSH_USER=svdleer

# SNMP Community Strings (CHANGE THESE!)
SNMP_COMMUNITY_ARRIS=your_arris_community_here
SNMP_COMMUNITY_CASA=your_casa_community_here
SNMP_COMMUNITY_CISCO=your_cisco_community_here
SNMP_COMMUNITY_COMMSCOPE=your_commscope_community_here

# CM Direct Access
CM_DIRECT_COMMUNITY=your_modem_community_here

# Optional UI skin: classic or brand
UI_SKIN=brand

# Authentication: lab uses local MySQL-backed username/password login
AUTH_PROVIDER=internal
EMERGENCY_LOCAL_AUTH=false

# Required MySQL auth storage (used with internal and Entra authentication)
AUTH_DB_HOST=mysql.example.internal
AUTH_DB_PORT=3306
AUTH_DB_USER=pypnm_auth
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
AUTH_DB_NAME=pypnm_auth
