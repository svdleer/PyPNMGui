# PyPNM Agent Installation Package
# Configuration for multi-agent setup

# Hosts
PYPNM_API_HOST="appdb-sh.oss.local"
MODEM_AGENT_HOST="hop-access1.ext.oss.local"

# PyPNM API Configuration
# Both agents connect to localhost:8000
# - CMTS agent: PyPNM API runs on same server (localhost)
# - Modem agent: Via SSH tunnel to CMTS server
PYPNM_API_URL="http://localhost:8000"

# Agent Authentication
AGENT_AUTH_TOKEN="change-me-production-token"

# CMTS Agent Configuration
CMTS_AGENT_ID="cmts-agent-appdb-sh"

# Modem Agent Configuration  
MODEM_AGENT_ID="modem-agent-hop-access1"

# SNMP Communities
SNMP_COMMUNITY_READ="public"
SNMP_COMMUNITY_WRITE="private"

# TFTP Configuration
TFTP_IPV4="172.16.6.101"
TFTP_IPV4_ALT="172.22.147.18"
TFTP_PATH="/tftpboot"
